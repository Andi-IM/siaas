{
  "SIAAS Page Wrapper": {
    "prefix": "sias-wrapper",
    "body": [
      "\"use client\";",
      "",
      "import { Suspense } from \"react\";",
      "import ${1:Feature}View, { ${1:Feature}Fallback } from \"./${1:Feature}View\";",
      "",
      "export default function ${1:Feature}Page() {",
      "  return (",
      "    <Suspense fallback={<${1:Feature}Fallback />}>",
      "      <${1:Feature}View />",
      "    </Suspense>",
      "  );",
      "}"
    ],
    "description": "Generate a thin Suspense wrapper page for SIAAS"
  },
  "SIAAS View Component": {
    "prefix": "sias-view",
    "body": [
      "\"use client\";",
      "",
      "export function ${1:Feature}Fallback() {",
      "  return (",
      "    <div className=\"form-page\">",
      "      <div className=\"form-page__inner\">",
      "        <div className=\"skeleton\" style={{ height: 24, width: 200, marginBottom: 24 }} />",
      "      </div>",
      "    </div>",
      "  );",
      "}",
      "",
      "export default function ${1:Feature}View() {",
      "  return (",
      "    <div>",
      "      <h1>${1:Feature} View</h1>",
      "      {/* Implementation details */}",
      "    </div>",
      "  );",
      "}"
    ],
    "description": "Generate a View component with Fallback for SIAAS"
  },
  "SIAAS Wrapper Test": {
    "prefix": "sias-test-wrapper",
    "body": [
      "import React from \"react\";",
      "import { render, screen } from \"@testing-library/react\";",
      "import { describe, it, expect, vi, beforeEach, afterEach } from \"vitest\";",
      "",
      "import * as ${1:Feature}ViewModule from \"@/app/${2:path}/${1:Feature}View\";",
      "import ${1:Feature}Page from \"@/app/${2:path}/page\";",
      "",
      "let shouldSuspend = false;",
      "",
      "describe(\"${1:Feature} Page Wrapper\", () => {",
      "  beforeEach(() => {",
      "    shouldSuspend = false;",
      "    vi.spyOn(${1:Feature}ViewModule, \"default\").mockImplementation(() => {",
      "      if (shouldSuspend) throw new Promise(() => {});",
      "      return <div data-testid=\"${3:test-id}-view\">${1:Feature} View</div>;",
      "    });",
      "  });",
      "",
      "  afterEach(() => {",
      "    vi.restoreAllMocks();",
      "  });",
      "",
      "  it(\"renders ${1:Feature}Page wrapper with ${1:Feature}View\", () => {",
      "    render(<${1:Feature}Page />);",
      "    expect(screen.getByTestId(\"${3:test-id}-view\")).toBeInTheDocument();",
      "  });",
      "",
      "  it(\"renders ${1:Feature}Page wrapper fallback during suspension\", () => {",
      "    shouldSuspend = true;",
      "    const { container } = render(<${1:Feature}Page />);",
      "    expect(container.querySelector(\".skeleton\")).toBeInTheDocument();",
      "  });",
      "});"
    ],
    "description": "Generate a Wrapper test using vi.spyOn pattern for SIAAS"
  }
}
