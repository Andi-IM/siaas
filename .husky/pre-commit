#!/bin/bash

# Ambil daftar file yang di-stage
STAGED_FILES=$(git diff --cached --name-only)

# Flags untuk mendeteksi tipe perubahan
RUST_CHANGES=false
TS_CHANGES=false

for FILE in $STAGED_FILES; do
  # Deteksi perubahan Rust (Backend)
  if echo "$FILE" | grep -qE '^src-tauri/|\.rs$|^Cargo\.(toml|lock)$'; then
    RUST_CHANGES=true
  fi
  
  # Deteksi perubahan TypeScript/JavaScript (Frontend)
  # Kita exclude folder docs/ jika ada perubahan di sana
  if echo "$FILE" | grep -qE '^src/|^package\.json$|^package-lock\.json$|^tsconfig\.json$|^vitest\.config\.mts$|^eslint\.config\.mjs$|\.(ts|tsx|js|jsx|mts)$'; then
    # Jika hanya merubah file di docs/ atau asset di public/, jangan trigger TS_CHANGES
    if ! echo "$FILE" | grep -qE '^docs/|^public/|^README\.md|^PRODUCT\.md|^DESIGN\.md|^GEMINI\.md'; then
      TS_CHANGES=true
    fi
  fi
done

# Jalankan Check Rust jika ada perubahan Rust
if [ "$RUST_CHANGES" = true ]; then
  echo "🦀 Rust changes detected. Running Rust checks..."
  
  echo "🔍 Running Rust Linting (Clippy)..."
  cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings || exit 1
  
  echo "🔍 Running Rust Format Check..."
  cargo fmt --manifest-path src-tauri/Cargo.toml -- --check || exit 1

  echo "🧪 Running Rust tests..."
  # Menggunakan --quiet untuk mengurangi output jika berhasil
  cargo test --manifest-path src-tauri/Cargo.toml --quiet || exit 1
  
  echo "✅ Rust checks passed!"
fi

# Jalankan Check Frontend jika ada perubahan TS/JS
if [ "$TS_CHANGES" = true ]; then
  echo "🚀 TypeScript/JavaScript changes detected. Running Frontend checks..."
  
  echo "🔍 Running Linting..."
  npm run lint || exit 1
  
  echo "🔍 Running Type-Checking..."
  npx tsc --noEmit || exit 1
  
  echo "🧪 Running Frontend Tests (Fast Mode)..."
  # Menggunakan test:fast agar tidak membebani dengan coverage saat pre-commit
  npm run test:fast || exit 1
  
  echo "✅ Frontend checks passed!"
fi

if [ "$RUST_CHANGES" = false ] && [ "$TS_CHANGES" = false ]; then
  echo "📝 No code changes detected. Skipping checks."
fi
