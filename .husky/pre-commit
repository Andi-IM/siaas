# Ambil daftar file yang di-stage
STAGED_FILES=$(git diff --cached --name-only)

# Cek apakah ada file yang berpengaruh pada kode/test
# Kriteria trigger:
# 1. File di dalam folder src/
# 2. File di dalam folder src-tauri/ (logic backend)
# 3. Konfigurasi (package.json, tsconfig.json, vitest.config.mts, etc)
# 4. File source (.ts, .tsx, .js, .jsx, .mts, .rs)

TRIGGER_CHECKS=false

for FILE in $STAGED_FILES; do
  if echo "$FILE" | grep -qE '^src/|^src-tauri/|^package\.json$|^tsconfig\.json$|^vitest\.config\.mts$|^\.github/|^\.env|\.(ts|tsx|js|jsx|mts|rs)$'; then
    TRIGGER_CHECKS=true
    break
  fi
done

if [ "$TRIGGER_CHECKS" = true ]; then
  echo "🚀 Code changes detected. Running verification checks..."
  
  # Cek apakah ada file Rust yang diubah
  RUST_CHANGES=false
  for FILE in $STAGED_FILES; do
    if echo "$FILE" | grep -qE '^src-tauri/|\.rs$'; then
      RUST_CHANGES=true
      break
    fi
  done

  if [ "$RUST_CHANGES" = true ]; then
    echo "🦀 Rust changes detected. Running Rust tests..."
    cargo test --manifest-path src-tauri/Cargo.toml || exit 1
  fi
  
  echo "🔍 Running Linting..."
  npm run lint || exit 1
  
  echo "🔍 Running Type-Checking..."
  npx tsc --noEmit || exit 1
  
  echo "🧪 Running Tests..."
  npm run test:coverage:full || exit 1
  
  echo "✅ All checks passed!"
else
  echo "📝 No code changes detected (only documentation or assets). Skipping checks."
fi
