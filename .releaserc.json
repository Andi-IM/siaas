{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {
      "changelogFile": "CHANGELOG.md"
    }],
    ["@semantic-release/npm", {
      "npmPublish": false
    }],
    ["@semantic-release/exec", {
      "prepareCmd": "node scripts/bump-tauri-version.js ${nextRelease.version} && npx tauri build && node scripts/generate-updater-json.js ${nextRelease.version}"
    }],
    ["@semantic-release/git", {
      "assets": ["package.json", "package-lock.json", "src-tauri/tauri.conf.json", "CHANGELOG.md"],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "assets": [
        {"path": "src-tauri/target/release/bundle/msi/*.msi", "label": "SIAAS Windows Installer (MSI)"},
        {"path": "src-tauri/target/release/bundle/msi/*.msi.zip", "label": "SIAAS Windows Update Archive (ZIP)"},
        {"path": "updater.json", "label": "Tauri Updater Manifest"}
      ]
    }]
  ]
}
