{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sias",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SIAAS - Academic Administrative Core",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.sias.app/updater?version={{current_version}}&target={{target}}&arch={{arch}}&os={{os}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQzFDNkU5MTgwOEMyRkQKUldUOXdnZ1k2Y2JCSzRIOE9ydW5FaDhFcWJDeTk3QnFhRmZncEdaQXZyd0JqSzEyMEZwbEk1dk0K"
    }
  }
}